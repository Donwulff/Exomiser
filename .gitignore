# Exomiser specific bits
/exomiser-db/data/
distribute.sh
# ontologizer and javautil are not on maven central
!phenix-repository/lib/*.jar

# Local runtime config / run artifacts (machine-specific paths; do not commit).
# Distribution template stays tracked: exomiser-cli/src/main/resources/application.properties
# Policy: keep real genomes, extracted data bundles, case YAMLs, and analysis
# output out of this repository — see AGENTS.md. (Tiny example VCFs under
# **/src/**/resources/ remain tracked; do not add real sample VCFs anywhere.)
/application.properties
/logs/
/results/
/cases/

# Exported local agent sessions can contain case details.
/20??-??-??-??????-*.txt

# Payloads / run debris if dropped at repo root (not module test fixtures)
/*.vcf
/*.vcf.gz
/*.vcf.gz.tbi
/*.bam
/*.cram
/*.mv.db
/*.zip
/data/*.zip
/data/*_hg19/
/data/*_hg38/
/data/*_phenotype/
# Local mktorrent bootstrap (dpkg-deb -x); not for commit
/data/.tools/
/mktorrent_*.deb



#Java stuff
*.class
*.DS_Store

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.ear

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Maven stuff
target/
bin/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
# Avoid ignoring Maven wrapper jar file (.jar files are usually ignored)
!maven-wrapper.jar

#Gradle stuff
.gradle
build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

